# Copie para .env; nunca versione credenciais reais.
SECRET_KEY=substitua-por-uma-chave-aleatoria-longa
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
MYSQL_DATABASE=barbearia
MYSQL_USER=barbearia
MYSQL_PASSWORD=
# No Docker, use o endereço acessível do MySQL externo.
# Para MySQL no host com Docker Desktop: host.docker.internal
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=
